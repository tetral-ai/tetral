{
  "schema_version": 1,
  "purpose": "Every span name template each Engine component starts and the attributes it may carry. Spans hold identities, sizes, durations and outcomes, never content, paths, queries, client addresses or error messages.",
  "services": {
    "agent-runtime": {},
    "api": {},
    "auth": {},
    "bridge": {
      "tool.admit": {
        "attributes": [
          "outcome",
          "task.id"
        ]
      }
    },
    "cleanup": {},
    "computer-hub": {
      "instruction.deliver": {
        "attributes": [
          "connection.id",
          "message.id",
          "message.type"
        ]
      },
      "execute_tool exec_command": {
        "attributes": [
          "task.id"
        ]
      },
      "execute_tool edit": {
        "attributes": [
          "task.id"
        ]
      },
      "execute_tool view_image": {
        "attributes": [
          "task.id"
        ]
      },
      "queued": {
        "attributes": []
      },
      "drive_wait": {
        "attributes": []
      },
      "run": {
        "attributes": []
      },
      "sync": {
        "attributes": []
      },
      "tool.settle": {
        "attributes": [
          "task.id"
        ]
      }
    },
    "db-prepare": {},
    "event-stream": {},
    "git-proxy": {},
    "job-runner": {
      "job_runner.run_job": {
        "attributes": [
          "queue.job.id",
          "queue.job.kind",
          "workspace.id"
        ]
      }
    },
    "mcp-connector": {},
    "provider-gateway": {},
    "queue": {},
    "sandbox": {},
    "ts-observability": {
      "{grpc.method}": {
        "attributes": [
          "rpc.grpc.status_name"
        ]
      },
      "{operation}": {
        "attributes": []
      }
    },
    "web-connector": {},
    "workload": {
      "{http.request.method} {http.route}": {
        "attributes": [
          "http.request.method",
          "http.route",
          "http.response.status_code"
        ]
      },
      "{grpc.method}": {
        "attributes": [
          "rpc.grpc.status_name"
        ]
      },
      "{db.operation.name}": {
        "attributes": [
          "db.operation.name"
        ]
      },
      "{operation}": {
        "attributes": []
      }
    }
  }
}
