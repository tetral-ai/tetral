// Ships the JSON records that Tetral workloads write to stderr to Loki.
//
// Run Grafana Alloy as a DaemonSet that mounts the node's /var/log read-only
// and sets HOSTNAME to the node name; the grafana/alloy Helm chart does both
// with alloy.mounts.varlog=true. Replace <CLUSTER_NAME> and <LOKI_PUSH_URL>.
// Loki must accept structured metadata, its default since Loki 3.0.

discovery.kubernetes "tetral_pods" {
  role = "pod"

  namespaces {
    names = ["tetral-system", "tetral-agent-runtime"]
  }

  selectors {
    role  = "pod"
    label = "app.kubernetes.io/part-of=tetral"
    field = "spec.nodeName=" + sys.env("HOSTNAME")
  }
}

discovery.relabel "tetral_containers" {
  targets = discovery.kubernetes.tetral_pods.targets

  // The mesh sidecar runs as an init container and writes no record.
  rule {
    source_labels = ["__meta_kubernetes_pod_container_init"]
    regex         = "true"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  // Taken from the Pod rather than the record, so output that is not a
  // record, such as a crash trace, still carries its service.
  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
    separator     = "/"
    target_label  = "__path__"
    replacement   = "/var/log/pods/*$1/*.log"
  }
}

local.file_match "tetral_containers" {
  path_targets = discovery.relabel.tetral_containers.output
}

loki.source.file "tetral_containers" {
  targets    = local.file_match.tetral_containers.targets
  forward_to = [loki.process.tetral_records.receiver]
}

loki.process "tetral_records" {
  stage.cri {}

  stage.json {
    expressions = {
      env      = "\"deployment.environment\"",
      log_type = "\"log.type\"",
      trace_id = "trace_id",
    }
  }

  stage.labels {
    values = {
      env      = "",
      log_type = "",
    }
  }

  // A trace ID is unique per trace, so it is structured metadata, never a label.
  stage.structured_metadata {
    values = {
      trace_id = "",
    }
  }

  stage.static_labels {
    values = {
      cluster = "<CLUSTER_NAME>",
    }
  }

  stage.label_keep {
    values = ["cluster", "namespace", "service", "env", "log_type"]
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "<LOKI_PUSH_URL>"
  }
}
