{
  "name": "@tetral/gateway-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov packages/protocol/test/unit/ packages/lowering/test/ packages/provider-gateway/test/unit/ packages/provider-gateway/test/golden/ packages/mcp-connector/test/unit/",
    "build": "bun build packages/provider-gateway/src/command.ts packages/provider-gateway/src/index.ts packages/mcp-connector/src/command.ts packages/mcp-connector/src/server.ts --outdir dist --entry-naming '[dir]-[name].[ext]' --target bun",
    "audit": "bun audit"
  },
  "tetral": {
    "providerGateway": {
      "entrypoint": "packages/provider-gateway/src/command.ts",
      "buildArtifact": "dist/provider-gateway/src-command.js",
      "image": "ghcr.io/tetral-ai/gateway:0.0.0-dev",
      "containerCommand": [
        "bun",
        "/app/dist/provider-gateway/src-command.js"
      ]
    },
    "mcpConnector": {
      "entrypoint": "packages/mcp-connector/src/command.ts",
      "buildArtifact": "dist/mcp-connector/src-command.js",
      "image": "ghcr.io/tetral-ai/gateway:0.0.0-dev",
      "containerCommand": [
        "bun",
        "/app/dist/mcp-connector/src-command.js"
      ]
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "1.3.14",
    "ts-proto": "2.11.8",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.82",
    "@ai-sdk/openai": "3.0.53",
    "@ai-sdk/openai-compatible": "2.0.41",
    "@ai-sdk/provider": "3.0.8",
    "@ai-sdk/provider-utils": "4.0.23",
    "@bufbuild/protobuf": "2.12.0",
    "@grpc/grpc-js": "1.14.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tetral/gateway-lowering": "workspace:*",
    "@tetral/mcp-connector": "workspace:*",
    "@tetral/gateway-protocol": "workspace:*",
    "@tetral/provider-gateway": "workspace:*",
    "ai": "6.0.168",
    "zod": "4.4.3"
  },
  "overrides": {
    "protobufjs": "7.6.5",
    "zod": "4.4.3",
    "fast-uri": "3.1.7",
    "qs": "6.16.0",
    "ip-address": "10.4.0",
    "hono": "4.12.34",
    "@hono/node-server": "2.0.10"
  }
}
