{
  "catalog_url": "https://api.githubcopilot.com/mcp/",
  "now": "2026-07-03T18:00:00Z",
  "cases": [
    {
      "name": "no-credential",
      "credentials": [],
      "expected": { "outcome": "error", "error": "credential_required" }
    },
    {
      "name": "one-mcp-oauth-valid",
      "credentials": [
        {
          "auth_type": "mcp_oauth",
          "mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "access_token": "gh-oauth-valid",
          "expires_at": "2026-07-03T19:00:00Z"
        }
      ],
      "expected": {
        "outcome": "use",
        "token": "gh-oauth-valid",
        "bearer_authorization": "Bearer gh-oauth-valid",
        "refresh_triggered": false
      }
    },
    {
      "name": "one-static-bearer",
      "credentials": [
        {
          "auth_type": "static_bearer",
          "mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "token": "gh-static-valid"
        }
      ],
      "expected": {
        "outcome": "use",
        "token": "gh-static-valid",
        "bearer_authorization": "Bearer gh-static-valid",
        "refresh_triggered": false
      }
    },
    {
      "name": "two-matching-credentials",
      "credentials": [
        {
          "auth_type": "static_bearer",
          "mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "token": "gh-first"
        },
        {
          "auth_type": "static_bearer",
          "mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "token": "gh-second"
        }
      ],
      "expected": { "outcome": "error", "error": "ambiguous" }
    },
    {
      "name": "one-matching-archived",
      "credentials": [
        {
          "auth_type": "static_bearer",
          "mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "token": "gh-archived",
          "archived": true
        }
      ],
      "expected": { "outcome": "error", "error": "credential_required" }
    },
    {
      "name": "one-matching-wrong-mcp-server-url",
      "credentials": [
        {
          "auth_type": "static_bearer",
          "mcp_server_url": "https://mcp.example.com/github/",
          "token": "gh-wrong-url"
        }
      ],
      "expected": { "outcome": "error", "error": "credential_required" }
    },
    {
      "name": "one-matching-undecryptable",
      "credentials": [
        {
          "auth_type": "static_bearer",
          "mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "token": "gh-corrupt",
          "encrypted_auth": "corrupt"
        }
      ],
      "expected": { "outcome": "error", "error": "undecryptable" }
    },
    {
      "name": "one-mcp-oauth-expired-refresh-block-present",
      "credentials": [
        {
          "auth_type": "mcp_oauth",
          "mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "access_token": "gh-expired",
          "expires_at": "2026-07-03T17:59:00Z",
          "refresh": {
            "refresh_token": "refresh-old",
            "client_id": "github-client",
            "token_endpoint": "https://auth.example.com/token",
            "token_endpoint_auth": { "type": "none" }
          }
        }
      ],
      "refresh_response": {
        "status": 200,
        "access_token": "gh-refreshed",
        "refresh_token": "refresh-new",
        "expires_in": 3600
      },
      "expected": {
        "outcome": "use",
        "token": "gh-refreshed",
        "bearer_authorization": "Bearer gh-refreshed",
        "refresh_triggered": true
      }
    },
    {
      "name": "one-mcp-oauth-expired-refresh-fails",
      "credentials": [
        {
          "auth_type": "mcp_oauth",
          "mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "access_token": "gh-expired-fail",
          "expires_at": "2026-07-03T17:59:00Z",
          "refresh": {
            "refresh_token": "refresh-old",
            "client_id": "github-client",
            "token_endpoint": "https://auth.example.com/token",
            "token_endpoint_auth": { "type": "none" }
          }
        }
      ],
      "refresh_response": { "status": 401, "body": "{\"error\":\"invalid_grant\"}" },
      "expected": { "outcome": "error", "error": "refresh_failed" }
    },
    {
      "name": "trailing-slash-url-variants",
      "credentials": [
        {
          "auth_type": "static_bearer",
          "mcp_server_url": "https://api.githubcopilot.com/mcp",
          "secret_mcp_server_url": "https://api.githubcopilot.com/mcp/",
          "token": "gh-trailing"
        }
      ],
      "expected": {
        "outcome": "use",
        "token": "gh-trailing",
        "bearer_authorization": "Bearer gh-trailing",
        "refresh_triggered": false
      }
    }
  ]
}
