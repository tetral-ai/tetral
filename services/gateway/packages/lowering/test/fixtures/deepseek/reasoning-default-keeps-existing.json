{
  "name": "assistant message with reasoning keeps existing reasoning_content",
  "rule": "deepseek-reasoning-default",
  "input": {
    "model": { "provider_id": "deepseek", "model_id": "deepseek-v4-pro" },
    "context": [
      {
        "role": 2,
        "content": [
          { "reasoning": { "text": "Existing reasoning.", "metadataJson": "{}" } },
          { "text": { "text": "Paris." } }
        ]
      }
    ]
  },
  "expected": {
    "messages": [
      {
        "role": "assistant",
        "content": [{ "type": "text", "text": "Paris." }],
        "providerOptions": { "deepseek": { "reasoning_content": "Existing reasoning." } }
      }
    ]
  }
}
