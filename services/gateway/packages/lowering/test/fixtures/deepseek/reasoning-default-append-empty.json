{
  "name": "assistant message without reasoning yields empty reasoning_content",
  "rule": "deepseek-reasoning-default",
  "input": {
    "model": { "provider_id": "deepseek", "model_id": "deepseek-v4-pro" },
    "context": [
      {
        "role": 2,
        "content": [
          { "text": { "text": "Paris is the capital." } }
        ]
      }
    ]
  },
  "expected": {
    "messages": [
      {
        "role": "assistant",
        "content": [{ "type": "text", "text": "Paris is the capital." }],
        "providerOptions": { "deepseek": { "reasoning_content": "" } }
      }
    ]
  }
}
