        "schema_history_gap": {
          "class": "schema_history_gap",
          "message_safe": "postgresql schema history is malformed"
        },
        "schema_history_malformed": {
          "class": "schema_history_malformed",
          "message_safe": "postgresql schema history is malformed"
        },
        "schema_lock_failed": {
          "class": "schema_lock_failed",
          "message_safe": "postgresql schema migration lock failed"
        },
        "schema_missing": {
          "class": "schema_missing",
          "message_safe": "postgresql schema registry is missing"
        },
        "schema_operation_canceled": {
          "class": "schema_operation_canceled",
          "message_safe": "postgresql schema operation was canceled"
        },
        "schema_rls_drift": {
          "class": "schema_rls_drift",
          "message_safe": "postgresql workspace isolation contract does not match this binary"
        },
        "schema_unexpected_state": {
          "class": "schema_unexpected_state",
          "message_safe": "postgresql schema is not empty and has no current identity"
        }
      }
