    "drive.transfer_refused": {
      "level": "WARN",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "binding.id": "string",
        "connection.id": "string",
        "drive.id": "string",
        "error.class": "string",
        "error.code": "string",
        "error.message_safe": "string",
        "operation": "string"
      },
      "errors": {
        "invalid_message": {
          "class": "client_refusal",
          "message_safe": "the request did not follow the drive transfer schema"
        },
        "content_hash_mismatch": {
          "class": "client_refusal",
          "message_safe": "the uploaded body's SHA-256 was not the URL's"
        },
        "credential_invalid": {
          "class": "client_refusal",
          "message_safe": "the connection key did not authenticate the request"
        },
        "credential_expired": {
          "class": "client_refusal",
          "message_safe": "the connection key had expired"
        },
        "credential_revoked": {
          "class": "client_refusal",
          "message_safe": "the connection key was revoked"
        },
        "instance_unavailable": {
          "class": "client_refusal",
          "message_safe": "the instance may not use the client routes"
        },
        "connection_conflict": {
          "class": "client_refusal",
          "message_safe": "another connection of the instance was active"
        },
        "stale_connection": {
          "class": "client_refusal",
          "message_safe": "the request named a connection that is not live"
        },
        "stale_binding": {
          "class": "client_refusal",
          "message_safe": "the request named no prepared or closing binding"
        },
        "drive_access_denied": {
          "class": "client_refusal",
          "message_safe": "the binding's drive set did not allow the request"
        },
        "request_too_large": {
          "class": "client_refusal",
          "message_safe": "the commit held more than 10,000 changes or 16 MiB"
        },
        "file_too_large": {
          "class": "client_refusal",
          "message_safe": "the upload declared more than 500,000,000 bytes"
        },
        "rate_limited": {
          "class": "client_refusal",
          "message_safe": "the workspace's upload budget was spent"
        },
        "content_missing": {
          "class": "client_refusal",
          "message_safe": "the commit named content the drive does not hold"
        }
      }
    },
