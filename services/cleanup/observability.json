{
  "service": "cleanup",
  "events": {
    "cleanup.claim_due.completed": {
      "level": "INFO",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "candidate.count": "integer",
        "cleanup.claim.limit": "integer",
        "cleanup.jobs.claimed": "integer",
        "component": "string",
        "duration.ms": "integer",
        "event.kind": "string",
        "failed.count": "integer",
        "operation": "string",
        "outcome": "string"
      }
    },
    "cleanup.metrics_export.failed": {
      "level": "ERROR",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "component": "string",
        "duration.ms": "integer",
        "error.class": "string",
        "error.code": "string",
        "error.message": "string",
        "error.message_safe": "string",
        "event.kind": "string",
        "operation": "string",
        "retryable": "boolean",
        "terminal": "boolean"
      },
      "errors": {
        "cleanup_metrics_export_failed": {
          "class": "metrics_export_error",
          "message_safe": "cleanup metrics export failed",
          "cause": true
        }
      }
    },
    "cleanup.retention.completed": {
      "level": "INFO",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "candidate.count": "integer",
        "component": "string",
        "deleted.count": "integer",
        "duration.ms": "integer",
        "event.kind": "string",
        "operation": "string",
        "outcome": "string",
        "page.count": "integer",
        "phase": "string"
      }
    },
    "controller_requests.expired": {
      "level": "INFO",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "component": "string",
        "controller_requests.claim_expired": "integer",
        "controller_requests.pending_expired": "integer",
        "operation": "string"
      }
    },
    "drive.cleanup_failed": {
      "level": "ERROR",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "component": "string",
        "drive.id": "string",
        "error.class": "string",
        "error.code": "string",
        "error.message": "string",
        "error.message_safe": "string",
        "operation": "string",
        "workspace.id": "string"
      },
      "errors": {
        "drive_cleanup_failed": {
          "class": "dependency_unavailable",
          "message_safe": "drive cleanup failed",
          "cause": true
        }
      }
    },
    "instance_credential_audit": {
      "level": "INFO",
      "log_type": "audit",
      "audience": "operators",
      "fields": {
        "actor.credential.id": "string",
        "actor.credential.kind": "string",
        "credential.id": "string",
        "edge.request.id": "string",
        "instance.id": "string",
        "operation": "string",
        "request.id": "string",
        "workspace.id": "string"
      }
    },
    "queue.notification_listener.disconnected": {
      "level": "WARN",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "consumer.class": "string",
        "error.class": "string",
        "error.code": "string",
        "error.message": "string",
        "error.message_safe": "string",
        "event.kind": "string",
        "operation": "string",
        "retryable": "boolean",
        "terminal": "boolean"
      },
      "errors": {
        "notification_listener_authentication": {
          "class": "queue_notification_listener_error",
          "message_safe": "queue notification listener disconnected",
          "cause": true
        },
        "notification_listener_endpoint_transport": {
          "class": "queue_notification_listener_error",
          "message_safe": "queue notification listener disconnected",
          "cause": true
        },
        "notification_listener_permission": {
          "class": "queue_notification_listener_error",
          "message_safe": "queue notification listener disconnected",
          "cause": true
        },
        "notification_listener_timeout": {
          "class": "queue_notification_listener_error",
          "message_safe": "queue notification listener disconnected",
          "cause": true
        },
        "notification_listener_unknown": {
          "class": "queue_notification_listener_error",
          "message_safe": "queue notification listener disconnected",
          "cause": true
        }
      }
    },
    "queue.notification_listener.recovered": {
      "level": "INFO",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "consumer.class": "string",
        "operation": "string",
        "outcome": "string",
        "recovery.event": "string"
      }
    },
    "schema.migration.completed": {
      "level": "INFO",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "duration_ms": "integer",
        "operation": "string",
        "schema.step": "string",
        "schema.version": "integer",
        "transaction.outcome": "string"
      }
    },
    "schema.migration.failed": {
      "level": "ERROR",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "db.sqlstate": "string",
        "duration_ms": "integer",
        "error.class": "string",
        "error.code": "string",
        "error.message": "string",
        "error.message_safe": "string",
        "operation": "string",
        "schema.step": "string",
        "schema.version": "integer",
        "transaction.outcome": "string"
      },
      "errors": {
        "schema_ahead": {
          "class": "schema_ahead",
          "message_safe": "postgresql schema is ahead of this binary",
          "cause": true
        },
        "schema_apply_failed": {
          "class": "schema_apply_failed",
          "message_safe": "postgresql schema migration failed",
          "cause": true
        },
        "schema_behind": {
          "class": "schema_behind",
          "message_safe": "postgresql schema is behind this binary",
          "cause": true
        },
        "schema_checksum_drift": {
          "class": "schema_checksum_drift",
          "message_safe": "postgresql schema checksum does not match this binary",
          "cause": true
        },
        "schema_history_duplicate": {
          "class": "schema_history_duplicate",
          "message_safe": "postgresql schema history is malformed",
          "cause": true
        },
        "schema_history_gap": {
          "class": "schema_history_gap",
          "message_safe": "postgresql schema history is malformed",
          "cause": true
        },
        "schema_history_malformed": {
          "class": "schema_history_malformed",
          "message_safe": "postgresql schema history is malformed",
          "cause": true
        },
        "schema_lock_failed": {
          "class": "schema_lock_failed",
          "message_safe": "postgresql schema migration lock failed",
          "cause": true
        },
        "schema_missing": {
          "class": "schema_missing",
          "message_safe": "postgresql schema registry is missing",
          "cause": true
        },
        "schema_operation_canceled": {
          "class": "schema_operation_canceled",
          "message_safe": "postgresql schema operation was canceled",
          "cause": true
        },
        "schema_rls_drift": {
          "class": "schema_rls_drift",
          "message_safe": "postgresql workspace isolation contract does not match this binary",
          "cause": true
        },
        "schema_unexpected_state": {
          "class": "schema_unexpected_state",
          "message_safe": "postgresql schema is not empty and has no current identity",
          "cause": true
        }
      }
    },
    "schema.migration.started": {
      "level": "INFO",
      "log_type": "app",
      "audience": "operators",
      "fields": {
        "duration_ms": "integer",
        "operation": "string",
        "schema.step": "string",
        "schema.version": "integer",
        "transaction.outcome": "string"
      }
    }
  },
  "operations": {
    "claim_due": {
      "long": false,
      "errors": [
        "cancelled",
        "timeout"
      ]
    }
  },
  "metrics": {
    "cleanup_controller_requests_expired_total": {
      "type": "counter",
      "audience": "operators",
      "labels": {
        "cause": [
          "claim_expired",
          "pending_expired"
        ]
      }
    },
    "tetral_cleanup_claim_due_duration_ms_total": {
      "type": "counter",
      "audience": "operators",
      "labels": {}
    },
    "tetral_cleanup_claim_due_runs_total": {
      "type": "counter",
      "audience": "operators",
      "labels": {}
    },
    "tetral_cleanup_jobs_claimed_total": {
      "type": "counter",
      "audience": "operators",
      "labels": {}
    },
    "tetral_cleanup_retention_budget_exhausted_total": {
      "type": "counter",
      "audience": "operators",
      "labels": {
        "phase": [
          "idempotency",
          "stream_changes"
        ]
      }
    }
  },
  "spans": {}
}
