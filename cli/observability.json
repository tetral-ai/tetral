{
  "events": [
    {"name": "cold_start.phase_started", "level": "INFO", "fields": [{"name": "cold_start.kind", "type": "enum", "values": ["cli"]}, {"name": "cold_start.phase", "type": "enum", "values": ["config", "connect", "ready"]}]},
    {"name": "cold_start.phase_completed", "level": "INFO", "fields": [{"name": "cold_start.kind", "type": "enum", "values": ["cli"]}, {"name": "cold_start.phase", "type": "enum", "values": ["config", "connect", "ready"]}, {"name": "config_ms", "type": "ms"}, {"name": "connect_ms", "type": "ms"}, {"name": "ready_ms", "type": "ms"}]},
    {"name": "connection.state_changed", "level": "INFO", "fields": [{"name": "connection.state", "type": "enum", "values": ["disconnected", "connecting", "registering", "online", "resuming", "blocked", "stopping", "stopped"]}]},
    {"name": "connection.unexpected_connected", "level": "WARN"},
    {"name": "diagnostic.invalid_event", "level": "WARN", "log_type": "app", "fields": [{"name": "event.original", "type": "event_name"}]},
    {"name": "log.file_open_failed", "level": "WARN", "log_type": "app", "errors": [{"code": "log_file_open_failed", "class": "io_error", "message_safe": "the log file could not be opened"}]},
    {"name": "pressure.rejecting_ended", "level": "WARN", "fields": [{"name": "pressure.point", "type": "enum", "values": ["tetral_probes"]}, {"name": "pressure.cause", "type": "enum", "values": ["timeout"]}, {"name": "pressure.rejected", "type": "integer"}]},
    {"name": "pressure.rejecting_started", "level": "WARN", "fields": [{"name": "pressure.point", "type": "enum", "values": ["tetral_probes"]}, {"name": "pressure.cause", "type": "enum", "values": ["timeout"]}]},
    {"name": "protocol.foreign_connection", "level": "WARN"},
    {"name": "protocol.sender_check_failed", "level": "ERROR", "errors": [{"code": "sender_check_failed", "class": "internal", "message_safe": "a message the CLI built failed its own decoder and was not sent"}]},
    {"name": "report.dropped", "level": "ERROR", "fields": [{"name": "http.response.status_code", "type": "integer"}], "errors": [{"code": "invalid_message", "class": "protocol", "message_safe": "Engine refused a report as an invalid message; it is not sent again"}, {"code": "content_hash_mismatch", "class": "protocol", "message_safe": "Engine refused a report's content hash; it is not sent again"}, {"code": "not_found", "class": "protocol", "message_safe": "Engine found nothing that a report names; it is not sent again"}, {"code": "content_not_found", "class": "protocol", "message_safe": "Engine found no content that a report names; it is not sent again"}, {"code": "connection_conflict", "class": "protocol", "message_safe": "Engine refused a report for a conflicting connection; it is not sent again"}, {"code": "previous_connection_active", "class": "protocol", "message_safe": "Engine refused a report while a previous connection is active; it is not sent again"}, {"code": "stale_binding", "class": "protocol", "message_safe": "Engine refused a report for a stale binding; it is not sent again"}, {"code": "content_missing", "class": "protocol", "message_safe": "Engine refused a report that names missing content; it is not sent again"}, {"code": "message_conflict", "class": "protocol", "message_safe": "Engine knows a report's message_id with other content; it is not sent again"}, {"code": "unknown_instruction", "class": "protocol", "message_safe": "Engine issued no instruction on this connection that a report answers; it is not sent again"}, {"code": "drive_cursor_expired", "class": "protocol", "message_safe": "Engine refused a report with an expired drive cursor; it is not sent again"}, {"code": "request_too_large", "class": "protocol", "message_safe": "Engine refused a report as too large; it is not sent again"}, {"code": "file_too_large", "class": "protocol", "message_safe": "Engine refused a report's file as too large; it is not sent again"}, {"code": "range_not_satisfiable", "class": "protocol", "message_safe": "Engine refused a report's range; it is not sent again"}, {"code": "rate_limited", "class": "protocol", "message_safe": "Engine refused a report over its rate limit; it is not sent again"}, {"code": "report_not_written", "class": "io_error", "message_safe": "a report could not be frozen under outbox/ and was not sent"}]},
    {"name": "task.output_write_failed", "level": "WARN", "errors": [{"code": "output_write_failed", "class": "io_error", "message_safe": "a task's log could not be written; the task and its reports go on"}]}
  ],
  "metrics": [
    {"name": "tetral_connection_state", "type": "gauge", "labels": [{"name": "state", "values": ["disconnected", "connecting", "registering", "online", "resuming", "blocked", "stopping", "stopped"]}]},
    {"name": "tetral_reconnects_total", "type": "counter", "labels": [{"name": "kind", "values": ["resume", "new"]}]},
    {"name": "tetral_startup_phase_seconds", "type": "gauge", "labels": [{"name": "phase", "values": ["config", "connect", "ready"]}]},
    {"name": "tetral_probes_in_progress", "type": "gauge"},
    {"name": "tetral_probes_limit", "type": "gauge"},
    {"name": "tetral_probes_queued", "type": "gauge"},
    {"name": "tetral_probes_oldest_queued_seconds", "type": "gauge"},
    {"name": "tetral_probes_queue_wait_seconds", "type": "histogram", "buckets": [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1, 2.5, 5, 10]},
    {"name": "tetral_probes_rejected_total", "type": "counter", "labels": [{"name": "cause", "values": ["timeout"]}]},
    {"name": "tetral_tasks_in_progress", "type": "gauge"},
    {"name": "tetral_tasks_queued", "type": "gauge"},
    {"name": "tetral_tasks_oldest_queued_seconds", "type": "gauge"},
    {"name": "tetral_tasks_queue_wait_seconds", "type": "histogram", "buckets": [0.1, 0.5, 1, 2.5, 5, 10, 30, 60, 120, 300, 600, 1800]},
    {"name": "tetral_tasks_rejected_total", "type": "counter", "labels": [{"name": "cause", "values": ["resource_exhausted"]}]},
    {"name": "tetral_uploads_in_progress", "type": "gauge"},
    {"name": "tetral_uploads_limit", "type": "gauge"},
    {"name": "tetral_uploads_queued", "type": "gauge"},
    {"name": "tetral_uploads_oldest_queued_seconds", "type": "gauge"},
    {"name": "tetral_uploads_queue_wait_seconds", "type": "histogram", "buckets": [0.1, 0.5, 1, 2.5, 5, 10, 30, 60, 120, 300, 600, 1800]},
    {"name": "tetral_uploads_rejected_total", "type": "counter", "labels": [{"name": "cause", "values": ["rate_limited"]}]},
    {"name": "tetral_downloads_in_progress", "type": "gauge"},
    {"name": "tetral_downloads_limit", "type": "gauge"},
    {"name": "tetral_downloads_queued", "type": "gauge"},
    {"name": "tetral_downloads_oldest_queued_seconds", "type": "gauge"},
    {"name": "tetral_downloads_queue_wait_seconds", "type": "histogram", "buckets": [0.1, 0.5, 1, 2.5, 5, 10, 30, 60, 120, 300, 600, 1800]},
    {"name": "tetral_downloads_rejected_total", "type": "counter", "labels": [{"name": "cause", "values": ["rate_limited"]}]},
    {"name": "tetral_log_write_failures_total", "type": "counter", "labels": [{"name": "sink", "values": ["stderr", "file"]}]}
  ]
}
