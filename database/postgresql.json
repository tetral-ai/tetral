  "global_tables": [
    "platform_provider_keys",
    "tetral_schema_migrations",
    "workspaces"
  ],
  "special_policies": [
    {
      "table": "api_keys",
      "name": "auth_lookup",
      "command": "SELECT",
      "using": "(current_setting('tetral.auth_lookup'::text, true) = 'true'::text)",
      "check": ""
    },
    {
      "table": "session_git_tickets",
      "name": "git_ticket_lookup",
      "command": "SELECT",
      "using": "(current_setting('tetral.git_ticket_lookup'::text, true) = 'true'::text)",
      "check": ""
    },
    {
      "table": "queue_jobs",
      "name": "queue_maintenance",
      "command": "ALL",
      "using": "(current_setting('tetral.queue_maintenance'::text, true) = 'true'::text)",
      "check": "(current_setting('tetral.queue_maintenance'::text, true) = 'true'::text)"
    },
    {
      "table": "queue_partition_counters",
      "name": "queue_maintenance",
      "command": "ALL",
      "using": "(current_setting('tetral.queue_maintenance'::text, true) = 'true'::text)",
      "check": "(current_setting('tetral.queue_maintenance'::text, true) = 'true'::text)"
    },
    {
      "table": "session_transient_attachments",
      "name": "transient_attachment_gc_select",
      "command": "SELECT",
      "using": "(current_setting('tetral.transient_attachment_gc'::text, true) = 'true'::text)",
      "check": ""
    },
    {
      "table": "session_transient_attachments",
      "name": "transient_attachment_gc_update",
      "command": "UPDATE",
      "using": "(current_setting('tetral.transient_attachment_gc'::text, true) = 'true'::text)",
      "check": "(current_setting('tetral.transient_attachment_gc'::text, true) = 'true'::text)"
    },
    {
      "table": "session_runtime_tool_results",
      "name": "transient_attachment_gc_select",
      "command": "SELECT",
      "using": "(current_setting('tetral.transient_attachment_gc'::text, true) = 'true'::text)",
      "check": ""
    }
  ]
}
