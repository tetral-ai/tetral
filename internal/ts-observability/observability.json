  "metrics": {
    "cold_start_phase_seconds": {
      "audience": "benchmarks",
      "buckets": "long",
      "labels": {
        "kind": [
          "service_pod"
        ],
        "phase": [
          "config",
          "dependencies",
          "ready"
        ],
        "service": "service names"
      },
      "type": "histogram"
    },
    "cold_start_seconds": {
      "audience": "benchmarks",
      "buckets": "long",
      "labels": {
        "kind": [
          "service_pod"
        ],
        "scope": [
          "engine",
          "total"
        ],
        "service": "service names"
      },
      "type": "histogram"
    },
    "grpc_server_request_duration_seconds": {
      "type": "histogram",
      "audience": "operators",
      "labels": {
        "code": [
          "OK",
          "Canceled",
          "Unknown",
          "InvalidArgument",
          "DeadlineExceeded",
          "NotFound",
          "AlreadyExists",
          "PermissionDenied",
          "ResourceExhausted",
          "FailedPrecondition",
          "Aborted",
          "OutOfRange",
          "Unimplemented",
          "Internal",
          "Unavailable",
          "DataLoss",
          "Unauthenticated"
        ],
        "method": "full gRPC method names the service registers",
        "service": "service names"
      },
      "buckets": "request"
    },
