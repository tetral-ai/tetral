  "groups": [
    {
      "id": "repository",
      "owner": "repository",
      "kind": "repository-integrity",
      "profiles": ["fast", "affected", "full"],
      "dependencies": [],
      "paths": ["**/*.go", "**/*.ts", "**/*.md", "Makefile"]
    },
    {
      "id": "go",
      "owner": "go",
      "kind": "go",
      "profiles": ["fast", "affected", "full"],
      "dependencies": [],
      "paths": ["**/*.go", "go.mod", "go.sum"]
    },
    {
      "id": "go-static",
      "owner": "go",
      "kind": "go-static",
      "profiles": ["full"],
      "dependencies": [],
      "paths": ["**/*.go", "go.mod", "go.sum", ".golangci.yml"]
    },
    {
      "id": "runtime",
      "owner": "services/agent-runtime",
      "kind": "bun-runtime",
      "profiles": ["fast", "affected", "full"],
      "dependencies": [],
      "paths": ["services/agent-runtime/**", "services/gateway/packages/protocol/**", "internal/ts-observability/**", "proto/**"]
    },
    {
      "id": "gateway",
      "owner": "services/gateway",
      "kind": "bun-gateway",
      "profiles": ["fast", "affected", "full"],
      "dependencies": [],
      "paths": ["services/gateway/**", "internal/ts-observability/**", "internal/ts-dbconnect/**", "proto/**"]
    },
    {
      "id": "protocol",
      "owner": "proto",
      "kind": "protocol",
      "profiles": ["affected", "full"],
      "dependencies": ["sdk"],
      "paths": ["proto/**", "services/*/proto/**", "buf.gen.yaml", "buf.yaml"]
    },
    {
      "id": "deployment",
      "owner": "deploy",
      "kind": "deployment",
      "profiles": ["affected", "full"],
      "dependencies": [],
      "paths": ["deploy/**", "services/*/k8s/**"]
    },
    {
      "id": "sandbox-image",
      "owner": "services/sandbox",
      "kind": "sandbox-image",
      "profiles": ["affected", "full"],
      "dependencies": ["docker"],
      "paths": ["Dockerfile.sandbox", "services/sandbox/**", "internal/sandbox/**", "scripts/run-sandbox-local-image-smoke.sh", "scripts/run-helper-privilege-container.sh"]
    },
    {
      "id": "security",
      "owner": "repository",
      "kind": "dependency-security",
      "profiles": ["full"],
      "dependencies": [],
      "paths": ["go.mod", "go.sum", "**/package.json", "**/bun.lock", "integration/static/**"]
    }
  ],
  "full_fallback_paths": [
    ".github/**",
    "internal/testinfra/**",
    "Makefile",
    "go.mod",
    "go.sum",
    "**/bun.lock",
    "proto/**",
    "internal/storage/postgresql_schema.go",
    "internal/storage/postgresql_migrator.go"
  ]
}
