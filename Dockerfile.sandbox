# The base image every sandbox boots from, and the image every environment
# artifact snapshot is built on top of. The driver references it by name
# (internal/sandbox/driver/provider.go, defaultDaytonaImage).
#
# Its contents are not a matter of taste: the helper's health subcommand
# (internal/sandbox/helper/internal/health) runs during resource materialization
# and fails materialization unless every item below is present. That check list
# and this recipe must move together.
#
#   sandbox         helper binary on PATH
#   rg              ripgrep, on PATH and runnable
#   runtime_root    /tmp/tetral-runtime exists at mode 0700
#   apply_patch     helper self-test (no external dependency)
#   rclone          on PATH
#   fusermount3     present and setuid
#   fuse_conf       /etc/fuse.conf contains user_allow_other
#   capture_procfd  /proc/self/fd reopen self-test (kernel, not packaging)

ARG SANDBOX_HELPER_BASE_IMAGE=docker.io/library/golang:1.25.13-alpine@sha256:1e0126852075c9c60731c8ba49088448b91f63e2aed97ca9d1a9791622a05946
ARG SANDBOX_RUNTIME_BASE_IMAGE=ghcr.io/tetral-ai/mirror/ubuntu:24.04@sha256:ee4d23cbccd3aa96de85ab491b0404aecdda1d458931e9ef1aaba733a1128ba9

FROM ${SANDBOX_HELPER_BASE_IMAGE} AS helper

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
      -o /out/sandbox ./internal/sandbox/helper/cmd/sandbox

# Full repository verification targets this stage explicitly. The nonce is
# runner-owned so Docker cannot satisfy a new evidence run from a cached test
# layer; it does not affect the release image below.
FROM helper AS helper-privilege-test
ARG TETRAL_HELPER_PRIVILEGE_TEST_NONCE
RUN test -n "${TETRAL_HELPER_PRIVILEGE_TEST_NONCE}" \
    && go test ./internal/sandbox/helper \
      -run '^TestSupervisorKeepsDetachedTaskAuthorizationAfterPrivilegeDrop$' \
      -count=1 -v
RUN test -n "${TETRAL_HELPER_PRIVILEGE_TEST_NONCE}" \
    && rm -rf /tmp/tetral-runtime \
    && go test ./internal/sandbox/helper/internal/cli \
      -run '^TestBuiltHelperDetachedExecReturnsPromptly$' \
      -count=1 -v

FROM ${SANDBOX_RUNTIME_BASE_IMAGE}

# Tool execution runs arbitrary user commands, so this image keeps a real
# distribution: a shell, coreutils, and the package manager's own dependency
# resolution. bash is the helper's preferred shell; sudo carries the two
# privilege transitions the driver performs (root for helper invocation, the
# runtime user for tool execution).
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash \
      ca-certificates \
      curl \
      fuse3 \
      git \
      ripgrep \
      sudo \
      unzip \
    && rm -rf /var/lib/apt/lists/*

# rclone comes from upstream, not the distribution: Ubuntu 24.04 ships
# v1.60.1, which predates --vfs-cache-min-free-space. The projection mount
# passes that flag, so the distribution build makes every resource
# projection fail with rclone's generic "mount not ready" after its
# daemon-wait expires. Pinned by version and verified by checksum.
# Not RCLONE_VERSION: rclone reads any RCLONE_* variable as a flag, and
# RCLONE_VERSION collides with its boolean --version.
ARG RCLONE_RELEASE=1.71.1
ARG RCLONE_ARCHIVE_SHA256=417e3da236f3a12d292da4e7287d67b1df558b8c2b280d092e563958ed724be7
RUN curl -fsSL -o /tmp/rclone.zip \
      "https://github.com/rclone/rclone/releases/download/v${RCLONE_RELEASE}/rclone-v${RCLONE_RELEASE}-linux-amd64.zip" \
 && printf '%s  /tmp/rclone.zip\n' "${RCLONE_ARCHIVE_SHA256}" | sha256sum -c - \
 && unzip -q -j /tmp/rclone.zip "rclone-v${RCLONE_RELEASE}-linux-amd64/rclone" -d /usr/bin \
 && chmod 0755 /usr/bin/rclone \
 && rm -f /tmp/rclone.zip \
 && rclone version \
 && rclone mount --help > /tmp/rclone-mount-help \
 && grep -q -- --vfs-cache-min-free-space /tmp/rclone-mount-help \
 && rm -f /tmp/rclone-mount-help

# fusermount3 ships setuid on some distributions and not others; the health
# check requires it, so the bit is set explicitly rather than assumed.
RUN chmod u+s /usr/bin/fusermount3

# rclone mounts are read by the runtime user while root owns the mount, which
# is exactly what user_allow_other governs.
RUN printf 'user_allow_other\n' > /etc/fuse.conf

# The runtime user's name is a contract with the driver
# (internal/sandbox/driver/types.go, RuntimeUser).
RUN useradd --create-home --shell /bin/bash daytona \
    && printf 'daytona ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/daytona \
    && chmod 0440 /etc/sudoers.d/daytona

COPY --from=helper /out/sandbox /usr/local/bin/sandbox

# The driver re-creates these per sandbox, but the health check reads the
# runtime root before any of that runs.
RUN install -d -m 0700 -o daytona -g daytona /tmp/tetral-runtime \
    && install -d -m 0755 -o daytona -g daytona /workspace

WORKDIR /workspace
USER daytona
CMD ["sleep", "infinity"]
